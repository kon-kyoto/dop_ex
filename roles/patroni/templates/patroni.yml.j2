scope: patroni_cluster
namespace: /patroni
name: {{ inventory_hostname }}

log:
  level: INFO
  dir: /data/log/patroni
  file_size: 50000000
  file_num: 10

restapi:
  listen: 0.0.0.0:8008
  connect_address: {{ inventory_hostname }}:8008
  verify_client: optional
  cafile: /opt/patroni/.tls/ca.crt
  certfile: /opt/patroni/.tls/{{ inventory_hostname }}.crt
  keyfile: /opt/patroni/.tls/{{ inventory_hostname }}.key

etcd3:
  hosts: [{% for h in groups['etcd'] %}"{{ h }}:2379"{{ ',' if not loop.last }}{% endfor %}]
  protocol: https
  cacert: /opt/patroni/.tls/ca.crt
  cert: /opt/patroni/.tls/{{ inventory_hostname }}.crt
  key: /opt/patroni/.tls/{{ inventory_hostname }}.key

bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    synchronous_mode: true
    synchronous_mode_strict: true
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        shared_buffers: '512MB'
        wal_level: 'replica'
        max_connections: 100
        hot_standby: 'on'
      pg_hba:
        - local all all peer
        - host all all 127.0.0.1/32 scram-sha-256
        - host all all 192.168.100.0/24 md5
        - host replication replicator 192.168.100.0/24 scram-sha-256
  initdb: ["encoding=UTF8", "data-checksums", "username=postgres", "auth=scram-sha-256"]

postgresql:
  listen: 0.0.0.0
  connect_address: {{ ansible_host }}:5432
  data_dir: /data/16
  config_dir: /data/16
  bin_dir: /usr/lib/postgresql/16/bin
  pgpass: /home/postgres/.pgpass_patroni
  authentication:
    replication:
      username: replicator
      password: '{{ patroni_repl_password }}'
    superuser:
      username: postgres
      password: '{{ patroni_superuser_password }}'
  parameters:
    unix_socket_directories: "/var/run/postgresql"
  create_replica_methods: ["basebackup"]
