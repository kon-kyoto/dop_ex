scope: patroni_cluster
namespace: /patroni
name: {{ inventory_hostname }}

restapi:
  listen: 0.0.0.0:{{ patroni_restapi_port }}
  connect_address: {{ ansible_host }}:8008

etcd3:
  hosts: [{% for h in groups['etcd'] %}"{{ hostvars[h].ansible_host }}:2379"{{ ',' if not loop.last }}{% endfor %}]

bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    synchronous_mode: true
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        wal_level: replica
        hot_standby: on
        max_connections: 100
      pg_hba:
        - local all all peer
        - host all all 127.0.0.1/32 scram-sha-256
        - host all all 192.168.100.0/24 scram-sha-256
        - host replication replicator 192.168.100.0/24 scram-sha-256
  initdb: ["encoding=UTF8", "data-checksums", "username=postgres", "auth=scram-sha-256"]

postgresql:
  listen: 0.0.0.0
  connect_address: {{ ansible_host }}:5432
  data_dir: /data/16
  config_dir: /data/16
  bin_dir: /usr/lib/postgresql/16/bin
  pgpass: /home/postgres/.pgpass_patroni
  authentication:
    replication:
      username: replicator
      password: '{{ patroni_repl_password }}'
    superuser:
      username: postgres
      password: '{{ patroni_superuser_password }}'
  parameters:
    unix_socket_directories: "/var/run/postgresql"
  create_replica_methods: ["basebackup"]
